# =============================================
# Frontend Environment Variables Template
# =============================================
# Vite requires all variables to be prefixed with VITE_
# Copy this file to .env and fill in your values
# Command: cp .env.example .env

# Backend API URL
# This is where your Express backend is running
VITE_API_URL=http://localhost:5000/api

# For production deployment, change to your actual backend URL:
# VITE_API_URL=https://your-backend-domain.com/api

# Example production URLs:
# Railway: VITE_API_URL=https://your-app.up.railway.app/api
# Render: VITE_API_URL=https://your-app.onrender.com/api
# Heroku: VITE_API_URL=https://your-app.herokuapp.com/api
# Custom Domain: VITE_API_URL=https://api.yourdomain.com/api

# -------------------------------------------
# Notes:
# -------------------------------------------
# 
# 1. VITE_ PREFIX:
#    - All environment variables MUST start with VITE_
#    - This is a Vite security feature
#    - Variables without VITE_ won't be exposed to the client
# 
# 2. API URL FORMAT:
#    - Must include /api at the end
#    - Should match your backend route prefix
#    - No trailing slash
# 
# 3. DEVELOPMENT vs PRODUCTION:
#    - Development: http://localhost:5000/api
#    - Production: https://your-backend-url.com/api
#    - Always use HTTPS in production
# 
# 4. CORS CONFIGURATION:
#    - Make sure your backend allows this frontend URL
#    - Check backend FRONTEND_URL environment variable
#    - Should match exactly (including protocol and port)
# 
# 5. RESTART REQUIRED:
#    - Changes to .env require server restart
#    - Stop dev server (Ctrl+C) and run 'npm run dev' again
# 
# 6. TROUBLESHOOTING:
#    - If API calls fail, check this URL is correct
#    - Verify backend is running and accessible
#    - Check browser console for CORS errors
#    - Test backend URL directly in browser
# 
