# ===========================================
# Backend Environment Variables Template
# ===========================================
# Copy this file to .env and fill in your actual values
# Command: cp .env.example .env

# -------------------------------------------
# Server Configuration
# -------------------------------------------
NODE_ENV=development                    # Options: development | production | test
PORT=5000                               # Backend server port (default: 5000)

# -------------------------------------------
# Database Configuration
# -------------------------------------------
# MongoDB Atlas Connection String
# Get from: https://cloud.mongodb.com/ → Clusters → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/liquid-sphere?retryWrites=true&w=majority

# IMPORTANT: Replace these placeholders:
# - username: Your MongoDB Atlas database username
# - password: Your MongoDB Atlas database password (URL-encode special characters)
# - cluster0.xxxxx: Your actual cluster address
# - liquid-sphere: Your database name

# Special Character URL Encoding:
# @ → %40
# # → %23
# ! → %21
# $ → %24
# % → %25
# ^ → %5E
# & → %26
# * → %2A
# ( → %28
# ) → %29

# -------------------------------------------
# JWT (JSON Web Token) Configuration
# -------------------------------------------
# Generate secure random strings (64 characters recommended)
# Command to generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_SECRET=your_super_secure_jwt_secret_key_min_64_characters_random_string_here
JWT_REFRESH_SECRET=your_super_secure_refresh_token_secret_key_min_64_characters_here
JWT_EXPIRE=15m                          # Access token expiry (e.g., 15m, 1h, 2d)
JWT_REFRESH_EXPIRE=7d                   # Refresh token expiry (e.g., 7d, 30d)

# -------------------------------------------
# Cookie & Session Secrets
# -------------------------------------------
# Generate secure random strings for cookies and sessions
COOKIE_SECRET=your_super_secure_cookie_secret_min_64_characters_random_string
SESSION_SECRET=your_super_secure_session_secret_min_64_characters_random_string

# -------------------------------------------
# Google OAuth 2.0 Configuration (OPTIONAL)
# -------------------------------------------
# Leave as placeholder values to disable Google Sign-In
# To enable Google OAuth:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials
# 5. Add authorized redirect URI: http://localhost:5000/api/auth/google/callback
# 6. Copy Client ID and Client Secret below

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# For production, change callback URL to your actual domain:
# GOOGLE_CALLBACK_URL=https://yourdomain.com/api/auth/google/callback

# -------------------------------------------
# Frontend URL (CORS Configuration)
# -------------------------------------------
# URL of your frontend application for CORS policy
FRONTEND_URL=http://localhost:5173

# For production, change to your actual frontend URL:
# FRONTEND_URL=https://yourdomain.com

# -------------------------------------------
# Rate Limiting Configuration
# -------------------------------------------
# Prevents brute force attacks and API abuse
RATE_LIMIT_WINDOW_MS=900000            # Time window in milliseconds (15 min = 900000)
RATE_LIMIT_MAX_REQUESTS=100            # Maximum requests per IP in the window

# -------------------------------------------
# Security Configuration
# -------------------------------------------
# Bcrypt password hashing rounds (higher = more secure but slower)
# Recommended: 12 for production, 10 for development
BCRYPT_ROUNDS=12

# -------------------------------------------
# Additional Notes
# -------------------------------------------
# 
# SECURITY WARNINGS:
# - NEVER commit .env file to version control
# - Add .env to .gitignore
# - Use different secrets for development and production
# - Rotate secrets periodically
# - Use strong, random values for all secrets
# - Keep minimum 64 characters for JWT secrets
# 
# MONGODB ATLAS SETUP:
# 1. Create account at https://www.mongodb.com/cloud/atlas
# 2. Create a free M0 cluster
# 3. Create database user (Database Access)
# 4. Whitelist IP address (Network Access) - use 0.0.0.0/0 for testing
# 5. Get connection string (Clusters → Connect → Drivers)
# 
# GENERATE SECRETS:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 
# TESTING:
# Test health endpoint: curl http://localhost:5000/health
# Test with Postman or any API client
# 
# PRODUCTION DEPLOYMENT:
# - Set NODE_ENV=production
# - Use environment variables platform (Heroku Config Vars, Railway Variables, etc.)
# - Enable HTTPS
# - Use strong secrets
# - Whitelist specific IPs in MongoDB
# - Set proper CORS origin
# 
